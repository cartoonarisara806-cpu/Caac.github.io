<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="เว็บไซต์แนะนำตัวและแสดงผลงานของ ARISARA AND THAMONWAN">
    <title>ประวัติและผลงานของ ARISARA AND THAMONWAN</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- ส่วนหัวของเว็บไซต์ -->
    <header>
        <h1>สวัสดีค่ะ! พวกเราคือ ARISARA AND THAMONWAN</h1>
        <p>ยินดีต้อนรับเข้าสู่เว็บไซต์แนะนำตัวและผลงานของพวกเรา</p>
    </header>

    <!-- ส่วนแนะนำตัวเอง -->
    <section id="about">
        <h2>เกี่ยวกับพวกเรา</h2>
        <p>
            พวกเราเป็นนักเรียนที่มีความตั้งใจในการเรียนรู้
            ชอบพัฒนาตนเองและเปิดรับประสบการณ์ใหม่ ๆ
            มีความมุ่งมั่นในการทำสิ่งต่าง ๆ ให้ดีที่สุด
            และเชื่อว่าทุกประสบการณ์เป็นโอกาสในการเรียนรู้
            เพื่อพัฒนาความสามารถและสร้างความภาคภูมิใจให้กับตนเอง
        </p>
    </section>

    <!-- ส่วนแสดงผลงาน -->
    <section id="projects">
        <h2>ผลงานและความภาคภูมิใจ</h2>

        <div class="project">
            <h3>เว็บไซต์ Portfolio</h3>
            <p>
                เว็บไซต์แนะนำตัวที่พวกเราสร้างขึ้น
                เพื่อรวบรวมประวัติ ความสามารถ และผลงาน
                ให้ทุกคนได้รู้จักพวกเรามากยิ่งขึ้น
            </p>
        </div>

        <div class="project">
            <h3>กิจกรรมและประสบการณ์</h3>
            <p>
                รวบรวมกิจกรรมและประสบการณ์ต่าง ๆ
                ที่ช่วยให้พวกเราได้เรียนรู้
                ฝึกฝนทักษะ และพัฒนาตนเอง
            </p>
        </div>
    </section>

    <!-- ส่วนแสดงทักษะ -->
    <section id="skills">
        <h2>ความสามารถและทักษะของพวกเรา</h2>
        <ul>
            <li>มีความรับผิดชอบและตั้งใจทำงาน</li>
            <li>มีความคิดสร้างสรรค์</li>
            <li>สามารถทำงานร่วมกับผู้อื่นได้ดี</li>
            <li>มีความกระตือรือร้นในการเรียนรู้สิ่งใหม่ ๆ</li>
            <li>พร้อมพัฒนาตนเองอยู่เสมอ</li>
        </ul>
    </section>

    <!-- ส่วนติดต่อและลิขสิทธิ์ -->
    <footer>
        <p>ผู้จัดทำ: ARISARA AND THAMONWAN</p>
        <p>&copy; <span id="year"></span> ARISARA AND THAMONWAN. All rights reserved.</p>
    </footer>

    <!-- เชื่อมต่อ JavaScript -->
    <script src="script.js"></script>

</body>
</html>
